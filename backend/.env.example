# Local development values only. Replace every placeholder before deploying.
NODE_ENV=development
PORT=3000
POSTGRES_PASSWORD=clena_local_only
DATABASE_URL=postgresql://clena:clena_local_only@postgres:5432/clena?schema=public

# These are public, development-only placeholders and must never be used in production.
JWT_ACCESS_SECRET=dev-only-access-secret-replace-before-production-00000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-before-production-00000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_SALT_ROUNDS=12
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5
TRUSTED_PROXY_IPS=
SEED_DEMO_DATA=true

# Optional development admin seed credentials. No admin or password is seeded by default.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
