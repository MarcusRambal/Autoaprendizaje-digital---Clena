# Copy this file to .env at the repository root and replace the placeholders.
# Never commit the root .env file or use development values in production.
# Copy this file to .env at the repository root and replace the placeholders.
# Never commit the root .env file or use development values in production.
NODE_ENV=development
PORT=3000
HOST_PORT=3000
POSTGRES_HOST_PORT=5433

# Letters and numbers only: it is also embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-secret

# Only used when the backend or the tests run outside Docker (for example
# `npx prisma migrate deploy` or `npm run test:integration` from your machine).
# docker compose builds its own URL from POSTGRES_PASSWORD. Keep the password equal.
DATABASE_URL=postgresql://clena:replace-with-a-unique-url-safe-secret@localhost:5433/clena?schema=public

# Origin allowed by CORS. The site served by nginx (http://localhost) calls the
# API on the same origin, so CORS does not apply there. Use
# http://localhost:5173 when you run Vite directly.
FRONTEND_URL=http://localhost:5173
# Only when Vite runs outside Docker and the API is not on 127.0.0.1:3000:
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# At least 32 characters and different from each other. To generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_SALT_ROUNDS=12
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5
TRUSTED_PROXY_IPS=

# Development seed: loads demo categories, guides and requests, and creates one
# account per role. Required while SEED_DEMO_DATA=true. The seed never runs in
# production. Each role needs its own email and a password of 8 to 72 bytes.
# Change these passwords: the values below are placeholders, not safe credentials.
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@clena.test
SEED_ADMIN_PASSWORD=replace-with-an-admin-password
SEED_STAFF_EMAIL=staff@clena.test
SEED_STAFF_PASSWORD=replace-with-a-staff-password
SEED_USER_EMAIL=usuario@clena.test
SEED_USER_PASSWORD=replace-with-a-user-password