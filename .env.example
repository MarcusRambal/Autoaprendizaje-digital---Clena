# Copy this file to .env at the repository root and replace the placeholders.
# Never commit the root .env file or use development values in production.
NODE_ENV=development
PORT=3000
HOST_PORT=3000
POSTGRES_HOST_PORT=5433
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-secret
DATABASE_URL=postgresql://clena:replace-with-a-unique-url-safe-secret@localhost:5433/clena?schema=public
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_SALT_ROUNDS=12
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5
TRUSTED_PROXY_IPS=
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
