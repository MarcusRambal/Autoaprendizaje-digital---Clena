# These values are for local development only. Compose has matching defaults,
# so a fresh clone can start with `docker compose up` without creating a .env.
# Copy this file to .env only to override those defaults. Never use these
# development credentials in production or commit a real .env file.
NODE_ENV=development
PORT=3000
HOST_PORT=3000
POSTGRES_HOST_PORT=5433
PRISMA_STUDIO_HOST_PORT=5555
NGINX_HOST_PORT=80

# Development-only password; letters and numbers keep it safe in DATABASE_URL.
POSTGRES_PASSWORD=clena_local_only

# Only used when the backend or the tests run outside Docker (for example
# `npx prisma migrate deploy` or `npm run test:integration` from your machine).
# docker compose builds its own URL from POSTGRES_PASSWORD. Keep the password equal.
DATABASE_URL=postgresql://clena:clena_local_only@localhost:5433/clena?schema=public

# CORS origin for the Compose frontend served at http://localhost.
# Set to http://localhost:5173 when running Vite directly on your machine.
FRONTEND_URL=http://localhost
# Only when Vite runs outside Docker and the API is not on 127.0.0.1:3000:
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Development-only signing keys (at least 32 characters and different).
# Generate private keys before deploying to production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-replace-before-production-00000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-before-production-00000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_SALT_ROUNDS=12
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5
TRUSTED_PROXY_IPS=

# Development seed: loads demo categories, guides and requests, and creates one
# account per role. Required while SEED_DEMO_DATA=true. The seed never runs in
# production. These demo-only credentials are also Compose's defaults.
# Change them for local use; never reuse them outside development.
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@clena.test
SEED_ADMIN_PASSWORD=clena-demo-admin-only
SEED_STAFF_EMAIL=staff@clena.test
SEED_STAFF_PASSWORD=clena-demo-staff-only
SEED_USER_EMAIL=usuario@clena.test
SEED_USER_PASSWORD=clena-demo-user-only